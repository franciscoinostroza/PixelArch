generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id               String   @id @default(cuid())
  clerkUserId      String   @unique
  polarCustomerId   String?  @unique
  nombre           String
  email            String   @unique
  empresa          String?
  telefono         String?
  activo           Boolean  @default(true)
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt

  suscripciones Suscripcion[]
  pagos         Pago[]
}

model Servicio {
  id                         String    @id @default(cuid())
  slug                       String?   @unique
  nombre                     String
  descripcion                String
  icono                      String?
  tags                       String[]

  precioUnico                Int
  precioBasico               Int
  precioMantenimiento        Int

  polarProductIdUnico         String?   @unique
  polarProductIdBasico        String?   @unique
  polarProductIdMantenimiento String?   @unique

  activo                     Boolean   @default(true)
  orden                      Int       @default(0)

  suscripciones Suscripcion[]
}

model Suscripcion {
  id                      String      @id @default(cuid())
  clienteId               String
  servicioId              String
  plan                    PlanTipo
  estado                  Estado
  polarSubscriptionId    String?     @unique
  polarTransactionId     String?
  deploymentId            String?
  deploymentPlatform      String?
  proximoPago             DateTime?
  entregadoEn             DateTime?
  cancelAtPeriodEnd       Boolean   @default(false)
  polarDiscountId         String?
  canceladoEn             DateTime?
  pastDueEn               DateTime?
  creadoEn                DateTime    @default(now())
  actualizadoEn           DateTime    @updatedAt

  cliente  Cliente  @relation(fields: [clienteId], references: [id])
  servicio Servicio @relation(fields: [servicioId], references: [id])
  pagos    Pago[]

  @@index([clienteId])
  @@index([servicioId])
  @@index([estado])
}

enum PlanTipo {
  UNICO
  BASICO
  MANTENIMIENTO
}

enum Estado {
  PENDING
  READY
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
}

model Pago {
  id              String     @id @default(cuid())
  clienteId       String
  suscripcionId   String?
  polarTransactionId String?     @unique
  monto           Int
  moneda          String     @default("usd")
  polarDiscountId String?
  discountAmount  Int?
  estadoPago      EstadoPago
  creadoEn        DateTime   @default(now())

  cliente     Cliente     @relation(fields: [clienteId], references: [id])
  suscripcion Suscripcion? @relation(fields: [suscripcionId], references: [id])

  @@index([clienteId])
  @@index([suscripcionId])
  @@index([creadoEn])
}

enum EstadoPago {
  SUCCEEDED
  FAILED
  REFUNDED
  PENDING
}
