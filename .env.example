# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
SANITY_REVALIDATE_SECRET=

# Base de datos
DATABASE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/redirect

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# PayPal (opcional; sin configuracion PayPal queda deshabilitado y Mercado Pago sigue funcionando)
# Server-only: no crear NEXT_PUBLIC_PAYPAL_* ni exponer estas variables al cliente
# (el checkout lo aloja PayPal; no se usa su JS SDK).
# Entorno: sandbox | production. Sandbox y produccion usan credenciales distintas.
# Sin valor o invalido, PayPal queda deshabilitado y no se crea ningun checkout.
PAYPAL_ENV=sandbox
# Credenciales de la app de PayPal Developer correspondientes al entorno elegido.
# No commitear valores reales; cargarlas en Railway o .env.local.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID del webhook del panel de PayPal (sandbox o produccion, segun PAYPAL_ENV).
# La firma se verifica server-to-server contra PayPal; si falta, el webhook da 503.
PAYPAL_WEBHOOK_ID=
# Override opcional de la API (solo https). Si se omite, se deriva de PAYPAL_ENV:
# sandbox=https://api-m.sandbox.paypal.com | production=https://api-m.paypal.com
PAYPAL_BASE_URL=
# Comision de PayPal para el gross-up: puntos basicos (540 = 5,40%) y fijo en
# centavos USD (30 = US$0,30). Default 5,40% + US$0,30; validar la tarifa real
# de la cuenta en sandbox antes de produccion (PAYPAL_FEE_* se puede cambiar sin deploy).
PAYPAL_FEE_BPS=540
PAYPAL_FEE_FIXED_CENTS=30

# Google Places API (reseñas)
GOOGLE_PLACES_API_KEY=

# Resend
RESEND_API_KEY=
CONTACT_EMAIL=
# Destinatario de alertas de uptime y digest diario (opcional; si no, usa CONTACT_EMAIL)
ADMIN_EMAIL=

# Deploy control (opcional)
CRON_SECRET=
RAILWAY_API_TOKEN=
VERCEL_API_TOKEN=

# Sentry (opcional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=pixelarch
SENTRY_PROJECT=pixelarch
SENTRY_AUTH_TOKEN=

# General
NEXT_PUBLIC_URL=https://pixelarch.dev

# Logging (opcional: debug | info | warn | error)
LOG_LEVEL=info
