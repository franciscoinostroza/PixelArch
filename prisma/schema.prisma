generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id               String   @id @default(cuid())
  clerkUserId      String?  @unique
  nombre           String
  email            String   @unique
  empresa          String?
  telefono         String?
  notas            String?
  activo           Boolean  @default(true)
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt

  suscripciones Suscripcion[]
  pagos         Pago[]
  proyectos     Proyecto[]
  enlacesPago   EnlacePago[]
}

model Servicio {
  id                         String    @id @default(cuid())
  slug                       String?   @unique
  nombre                     String
  descripcion                String
  icono                      String?
  tags                       String[]

  precioUnico                Int
  precioBasico               Int
  precioMantenimiento        Int

  activo                     Boolean   @default(true)
  orden                      Int       @default(0)

  suscripciones Suscripcion[]
  proyectos     Proyecto[]
}

model Suscripcion {
  id                      String      @id @default(cuid())
  clienteId               String
  servicioId              String
  plan                    PlanTipo
  estado                  Estado
  deploymentId            String?
  deploymentPlatform      String?
  platformServiceId       String?
  proximoPago             DateTime?
  entregadoEn             DateTime?
  cancelAtPeriodEnd       Boolean   @default(false)
  canceladoEn             DateTime?
  pastDueEn               DateTime?
  precioCustom            Int?
  ultimoRecordatorioEn    DateTime?
  mpLink                  String?
  mpPreferenceId          String?
  mpLinkExpira            DateTime?
  mpLinkMeses             Int?
  creadoEn                DateTime    @default(now())
  actualizadoEn           DateTime    @updatedAt

  cliente     Cliente      @relation(fields: [clienteId], references: [id])
  servicio    Servicio     @relation(fields: [servicioId], references: [id])
  pagos       Pago[]
  enlacesPago EnlacePago[]

  @@index([clienteId])
  @@index([servicioId])
  @@index([estado])
}

enum PlanTipo {
  UNICO
  BASICO
  MANTENIMIENTO
  SOPORTE
}

enum Estado {
  PENDING
  READY
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
}

model Pago {
  id                  String          @id @default(cuid())
  clienteId           String
  suscripcionId       String?
  hitoId              String?
  enlacePagoId        String?
  externalId          String?         @unique
  paypalOrderId       String?         @unique
  monto               Int
  montoAcordado       Int?
  comision            Int             @default(0)
  montoEsperado       Int?
  meses               Int?
  feeBps              Int?
  feeFixedCents       Int?
  moneda              String          @default("usd")
  cotizacion          Float?
  metodo              MetodoPago?
  pasarela            Pasarela        @default(MANUAL)
  origen              OrigenPago      @default(MANUAL)
  nota                String?
  evidencia           String?
  registradoPor       String?
  estadoPago          EstadoPago
  reciboId            String?         @unique
  reciboEmitidoEn     DateTime?
  revisionEstado      EstadoRevision?
  revisionNota        String?
  revisionResueltaPor String?
  revisionResueltaEn  DateTime?
  creadoEn            DateTime        @default(now())

  cliente     Cliente      @relation(fields: [clienteId], references: [id])
  suscripcion Suscripcion? @relation(fields: [suscripcionId], references: [id])
  hito        Hito?        @relation(fields: [hitoId], references: [id])
  enlacePago  EnlacePago?  @relation(fields: [enlacePagoId], references: [id])
  ajustes     AjustePago[]
  eventos     EventoPasarela[]

  @@index([clienteId])
  @@index([suscripcionId])
  @@index([hitoId])
  @@index([creadoEn])
}

model EnlacePago {
  id                String       @id @default(cuid())
  token             String       @unique
  clienteId         String
  hitoId            String?
  suscripcionId     String?
  pasarela          Pasarela
  concepto          String
  descripcion       String?
  notaInterna       String?
  montoAcordado     Int
  comision          Int          @default(0)
  total             Int
  moneda            String       @default("usd")
  meses             Int?
  feeBps            Int          @default(0)
  feeFixedCents     Int          @default(0)
  url               String?
  checkoutUrl       String?
  externalId        String?      @unique // preferenceId MP u orderId PayPal
  estado            EstadoEnlace @default(CREANDO)
  grupoCobroId      String
  expiraEn          DateTime
  orderExpiraEn     DateTime?
  generadoPor       String?
  generadoPorNombre String?
  enviadoPor        String?
  enviadoEn         DateTime?
  canalEnvio        String?      // EMAIL | WHATSAPP | COPIA
  idioma            String?      // es | en
  invalidadoEn      DateTime?
  motivoInvalido    String?
  ultimoError       String?
  creadoEn          DateTime     @default(now())
  actualizadoEn     DateTime     @updatedAt

  cliente     Cliente         @relation(fields: [clienteId], references: [id])
  hito        Hito?           @relation(fields: [hitoId], references: [id])
  suscripcion Suscripcion?    @relation(fields: [suscripcionId], references: [id])
  pagos       Pago[]
  eventos     EventoPasarela[]

  @@index([clienteId])
  @@index([hitoId])
  @@index([suscripcionId])
  @@index([estado])
  @@index([grupoCobroId])
  @@index([expiraEn])
}

model EventoPasarela {
  id             String    @id @default(cuid())
  pasarela       Pasarela
  eventoId       String    @unique
  tipo           String
  externalId     String?
  enlacePagoId   String?
  pagoId         String?
  resultado      String    // PROCESADO | IGNORADO | DUPLICADO | REQUIERE_ACCION | FIRMA_INVALIDA | ERROR
  motivo         String?
  monto          Int?
  moneda         String?
  requiereAccion Boolean   @default(false)
  creadoEn       DateTime  @default(now())
  procesadoEn    DateTime?

  enlacePago EnlacePago? @relation(fields: [enlacePagoId], references: [id])
  pago       Pago?       @relation(fields: [pagoId], references: [id])

  @@index([pasarela, creadoEn])
  @@index([enlacePagoId])
  @@index([pagoId])
  @@index([requiereAccion])
}

model AjustePago {
  id               String         @id @default(cuid())
  pagoId           String
  tipo             TipoAjuste
  monto            Int
  motivo           String?
  evidencia        String?
  decision         DecisionAjuste @default(NINGUNA)
  mesesDescontados Int?
  registradoPor    String?
  creadoEn         DateTime       @default(now())

  pago Pago @relation(fields: [pagoId], references: [id])

  @@index([pagoId])
}

model Proyecto {
  id            String         @id @default(cuid())
  clienteId     String
  servicioId    String?
  titulo        String
  montoTotal    Int
  estado        EstadoProyecto @default(ACTIVO)
  notas         String?
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt

  cliente  Cliente   @relation(fields: [clienteId], references: [id])
  servicio Servicio? @relation(fields: [servicioId], references: [id])
  hitos    Hito[]

  @@index([clienteId])
  @@index([estado])
}

model Hito {
  id          String     @id @default(cuid())
  proyectoId  String
  orden       Int
  titulo      String
  monto       Int
  estado      EstadoHito @default(PENDIENTE)
  vencimiento DateTime?
  pagadoEn    DateTime?
  mpLink         String?
  mpPreferenceId String?
  mpLinkExpira   DateTime?
  creadoEn    DateTime   @default(now())

  proyecto    Proyecto     @relation(fields: [proyectoId], references: [id])
  pagos       Pago[]
  enlacesPago EnlacePago[]

  @@index([proyectoId])
  @@index([estado])
}

enum EstadoProyecto {
  ACTIVO
  ENTREGADO
  CANCELADO
}

enum EstadoHito {
  PENDIENTE
  PAGADO
}

enum MetodoPago {
  TRANSFERENCIA
  MERCADOPAGO
  PAYPAL
  EFECTIVO
  OTRO
}

enum EstadoPago {
  SUCCEEDED
  FAILED
  REFUNDED
  PENDING
  REVISION
  CONTRACARGO
}

enum Pasarela {
  MANUAL
  MERCADOPAGO
  PAYPAL
}

enum OrigenPago {
  AUTOMATICO
  MANUAL
}

enum EstadoEnlace {
  CREANDO
  ACTIVO
  PAGADO
  VENCIDO
  INVALIDADO
  FALLIDO
}

enum EstadoRevision {
  PENDIENTE
  ACEPTADO
  RECHAZADO
}

enum TipoAjuste {
  REEMBOLSO
  CONTRACARGO
}

enum DecisionAjuste {
  NINGUNA
  REVERTIR_HITO
  DESCONTAR_MESES
}

model UptimeCheck {
  id         String   @id @default(cuid())
  servicio   String
  ok         Boolean
  statusCode Int?
  latenciaMs Int
  creadoEn   DateTime @default(now())

  @@index([servicio, creadoEn])
  @@index([creadoEn])
}

// ---------------------------------------------------------------------------
// Portal de propuestas y prospeccion asistida (spec 004, plan §4.1)
//
// Cambio aditivo: tablas, enums e indices nuevos. No se altera ningun modelo
// del CRM y no hay FKs ni relaciones a Cliente, Pago, Suscripcion, EnlacePago,
// Proyecto ni Hito (AC-6, AC-43).
// ---------------------------------------------------------------------------

enum EstadoCampanaProspeccion {
  BORRADOR
  EN_CURSO
  COMPLETADA
  PARCIAL
  CANCELADA
  FALLIDA
}

enum EstadoProspecto {
  NUEVO
  SIN_ENRIQUECER
  ENRIQUECIDO
  PUNTUADO
  BORRADOR
  APROBADO
  ENVIADO
  RESPONDIO
  DESCARTADO
  SUPRIMIDO
}

enum EstadoEnvioPropuesta {
  BORRADOR
  APROBADO
  ENVIANDO
  ENVIADO
  FALLIDO
  REBOTADO
  QUEJA
  RESPONDIDO
  CANCELADO
}

enum AmbitoSupresion {
  EMAIL
  DOMINIO
}

enum MotivoSupresion {
  OPT_OUT
  REBOTE_DURO
  QUEJA
  MANUAL
  SOLICITUD_ARCO
}

enum OrigenSupresion {
  ENLACE
  MANUAL
  ARCO
}

enum FuenteDatoProspecto {
  PLACES
  WEB_NEGOCIO
  CARGA_MANUAL
}

enum ProveedorConsumo {
  GOOGLE_PLACES
  WEB_FETCH
  AUDITORIA
  REDACTOR
  RESEND
}

model CampanaProspeccion {
  id                String                   @id @default(cuid())
  nombre            String
  consulta          String
  zona              String?
  rubro             String?
  filtros           Json?
  estado            EstadoCampanaProspeccion @default(BORRADOR)
  limiteCorrida     Int                      @default(20)
  plantillaId       String?
  creadaPor         String
  creadaPorNombre   String?
  idempotencyKey    String?                  @unique
  ultimoError       String?
  iniciadaEn        DateTime?
  finalizadaEn      DateTime?
  creadoEn          DateTime                 @default(now())
  actualizadoEn     DateTime                 @updatedAt

  plantilla  PlantillaPropuesta? @relation(fields: [plantillaId], references: [id], onDelete: SetNull)
  prospectos Prospecto[]
  envios     EnvioPropuesta[]
  consumos   ConsumoProveedor[]

  @@index([estado, creadoEn])
  @@index([creadaPor])
}

model Prospecto {
  id                   String              @id @default(cuid())
  nombreNegocio        String
  sitioWeb             String?
  dominioNormalizado   String?
  ciudad               String?
  rubro                String?
  placeId              String?             @unique
  email                String?             @unique
  telefono             String?
  contactoNombre       String?
  contactoCargo        String?
  emailFuenteUrl       String?
  emailFechaFuente     DateTime?
  fuenteTipo           FuenteDatoProspecto?
  fuenteUrl            String?
  fechaFuente          DateTime?
  estado               EstadoProspecto    @default(NUEVO)
  score                Int?
  scoreDetalle         Json?
  auditoriaResumen     Json?
  auditoriaEstado      String?
  auditoriaFecha       DateTime?
  posibleDuplicadoDeId String?
  motivoSinEnriquecer  String?
  baseLegal            String?
  notaLegal            String?
  notas                String?
  arcoHistorial        Json?
  historial            Json?
  actualizadoPor       String?
  ultimaInteraccionEn  DateTime            @default(now())
  ultimoEnvioEn        DateTime?
  creadoEn             DateTime            @default(now())
  actualizadoEn        DateTime            @updatedAt
  campanaOrigenId      String

  campanaOrigen CampanaProspeccion @relation(fields: [campanaOrigenId], references: [id], onDelete: Cascade)
  envios        EnvioPropuesta[]
  consumos      ConsumoProveedor[]

  @@index([estado, actualizadoEn])
  @@index([campanaOrigenId, estado])
  @@index([dominioNormalizado])
  @@index([posibleDuplicadoDeId])
  @@index([ultimaInteraccionEn])
}

model PlantillaPropuesta {
  id                  String   @id @default(cuid())
  nombre              String
  idioma              String   @default("es")
  asunto              String
  cuerpo              String
  variablesPermitidas Json
  version             Int      @default(1)
  activa              Boolean  @default(true)
  creadaPor           String
  creadaPorNombre     String?
  creadoEn            DateTime @default(now())
  actualizadoEn       DateTime @updatedAt

  campanas CampanaProspeccion[]
  envios   EnvioPropuesta[]

  @@unique([nombre, version])
  @@index([activa])
}

model EnvioPropuesta {
  id                  String               @id @default(cuid())
  prospectoId         String
  campanaId           String
  plantillaId         String?
  plantillaVersion    Int?
  secuencia           Int
  version             Int                  @default(1)
  destinatario        String
  fromEmail           String?
  fromNombre          String?
  replyTo             String?
  asunto              String
  cuerpoHtml          String
  cuerpoTexto         String
  hashContenido       String
  tokenBaja           String?
  estado              EstadoEnvioPropuesta @default(BORRADOR)
  aprobadoAsunto      String?
  aprobadoCuerpoHtml  String?
  aprobadoCuerpoTexto String?
  aprobadoHash        String?
  aprobadoPor         String?
  aprobadoPorNombre   String?
  aprobadoEn          DateTime?
  enviadoPor          String?
  enviadoPorNombre    String?
  enviadoEn           DateTime?
  proveedorMessageId  String?              @unique
  idempotencyKey      String?              @unique
  error               String?
  intentos            Int                  @default(0)
  motivoCancelacion   String?
  creadoEn            DateTime             @default(now())
  actualizadoEn       DateTime             @updatedAt

  prospecto Prospecto           @relation(fields: [prospectoId], references: [id], onDelete: Cascade)
  campana   CampanaProspeccion  @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  plantilla PlantillaPropuesta? @relation(fields: [plantillaId], references: [id], onDelete: SetNull)

  @@unique([prospectoId, secuencia, version])
  @@index([estado, creadoEn])
  @@index([prospectoId, secuencia])
  @@index([campanaId, estado])
}

model SupresionProspecto {
  id                 String          @id @default(cuid())
  ambito             AmbitoSupresion
  clave              String          @unique
  emailHash          String?
  emailEnmascarado   String?
  dominioNegocio     String?
  motivo             MotivoSupresion
  origen             OrigenSupresion
  activa             Boolean         @default(true)
  notas              String?
  historial          Json?
  creadaPor          String?
  creadaPorNombre    String?
  creadaEn           DateTime        @default(now())
  revocadaPor        String?
  revocadaEn         DateTime?
  motivoRevocacion   String?

  @@index([ambito, activa])
  @@index([emailHash])
  @@index([dominioNegocio])
}

model ConsumoProveedor {
  id             String           @id @default(cuid())
  clave          String           @unique
  campanaId      String
  prospectoId    String?
  proveedor      ProveedorConsumo
  fecha          DateTime         @db.Date
  llamadas       Int              @default(0)
  unidades       Int              @default(0)
  costoCentavos  Int              @default(0)
  creadoEn       DateTime         @default(now())
  actualizadoEn  DateTime         @updatedAt

  campana   CampanaProspeccion @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  prospecto Prospecto?         @relation(fields: [prospectoId], references: [id], onDelete: SetNull)

  @@index([campanaId, proveedor, fecha])
  @@index([prospectoId])
  @@index([proveedor, fecha])
}
